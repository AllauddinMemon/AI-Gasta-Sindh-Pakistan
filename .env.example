# ============================================================
# GASTA AI — Root example environment file
# Copy relevant blocks into server/.env and client/.env.local
# NEVER commit real .env files. Keys must never reach the frontend.
# ============================================================

# ---------- SERVER (server/.env) ----------
NODE_ENV=development
PORT=5000

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://gasta:gasta_password@localhost:5432/gasta_ai?schema=public"

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# AI provider (abstracted). Leave AI_PROVIDER=mock to run without a key.
AI_PROVIDER=mock              # mock | openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# File storage (abstracted). local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
MAX_UPLOAD_MB=10
# S3 (only needed when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# CORS — comma separated list of allowed origins
CLIENT_ORIGIN=http://localhost:3001

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---------- CLIENT (client/.env.local) ----------
NEXT_PUBLIC_API_URL=http://localhost:5000/api
